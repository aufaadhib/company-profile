# Neon runtime connection (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Neon migration connection (direct)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Resend sender must use a verified domain
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="noreply@example.com"
RESEND_FROM_NAME="Afana"

# Cloudflare Turnstile public and server keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace_me"
TURNSTILE_SECRET_KEY="replace_me"

# Random secrets, at least 32 characters
CONTACT_RATE_LIMIT_SECRET="replace_with_a_random_secret"
CRON_SECRET="replace_with_a_random_secret"

# Afana CMS authentication
BETTER_AUTH_SECRET="replace_with_a_random_secret_at_least_32_characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_a_stable_32_byte_base64_key"
CMS_OWNER_EMAIL="owner@example.com"
CMS_OWNER_NAME="Afana Owner"

# Vercel Blob public store used by published Media images
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
